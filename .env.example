# ==============================================================================
# SINGLE SOURCE OF TRUTH FOR CONFIGURATION
# To switch from local dev to VPS / domain, simply update APP_URL and BACKEND_URL!
# ==============================================================================

# Public Web Application (Frontend) URL. OAuth redirect URIs automatically use this base!
# Local: http://localhost:3000 or http://localhost:3000
# VPS:   http://<YOUR_VPS_IP>:3000 or https://yourdomain.com
APP_URL=http://localhost:3000

# Backend URL (used by Next.js server-side proxy).
# Local: http://localhost:8000
# Docker: http://backend:8000
BACKEND_URL=http://localhost:8000

# Ports
PORT=8000
FRONTEND_PORT=3000

# Required Infrastructure
DATABASE_URL=postgres://postgres:postgres@localhost:5432/test-instance
REDIS_URL=redis://localhost:6379
COOKIE_SECURE=false

# 32-byte AES-256 key, encoded as 64 hex characters (openssl rand -hex 32)
APP_ENCRYPTION_KEY=replace-with-64-hex-characters

# OAuth Credentials (Redirect URIs automatically default to ${APP_URL}/auth/.../callback)
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
HACKCLUB_REDIRECT_URI=

HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
HACKATIME_REDIRECT_URI=

# Optional Provider Base URLs
ATTEND_API_BASE_URL=https://attend.hackclub.com
ATTEND_API_KEY=

HACKATIME_API_BASE_URL=https://hackatime.hackclub.com

LAPSE_API_BASE_URL=https://api.lapse.hackclub.com
LAPSE_API_TOKEN=

# Airtable Sync Configuration
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_PARTICIPANTS_TABLE=Participants
AIRTABLE_PROJECTS_TABLE=Projects
AIRTABLE_PARTICIPANT_ID_FIELD=Participant ID
AIRTABLE_PROJECT_ID_FIELD=Project ID
AIRTABLE_FRAUD_APPROVAL_FIELD=Fraud Approval
AIRTABLE_SYNC_INTERVAL_SECONDS=300
