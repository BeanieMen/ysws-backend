# Required infrastructure
DATABASE_URL=postgres://postgres:postgres@localhost:5432/test
REDIS_URL=redis://localhost:6379
PORT=3000
COOKIE_SECURE=false

# A 32-byte AES-256 key, encoded as 64 lowercase/uppercase hex characters.
# Generate one with: openssl rand -hex 32
APP_ENCRYPTION_KEY=replace-with-64-hex-characters

# Attendance provider. ATTEND_API_KEY is sent as a bearer token.
ATTEND_API_BASE_URL=https://attend.hackclub.com
ATTEND_API_KEY=

# Hackatime user API. Tokens are provided through the API and encrypted at rest.
HACKATIME_API_BASE_URL=https://hackatime.hackclub.com
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
HACKATIME_REDIRECT_URI=http://localhost:3000/auth/hackatime/callback

# Hack Club Auth. Create an OAuth app at https://auth.hackclub.com.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
HACKCLUB_REDIRECT_URI=http://localhost:3000/auth/hackclub/callback

# Lapse service-to-service API.
LAPSE_API_BASE_URL=https://api.lapse.hackclub.com
LAPSE_API_TOKEN=

# Airtable sync. The service creates/updates participant and shipped-project
# records, then imports the project table's fraud approval value.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_PARTICIPANTS_TABLE=Participants
AIRTABLE_PROJECTS_TABLE=Projects
AIRTABLE_PARTICIPANT_ID_FIELD=Participant ID
AIRTABLE_PROJECT_ID_FIELD=Project ID
AIRTABLE_FRAUD_APPROVAL_FIELD=Fraud Approval
AIRTABLE_SYNC_INTERVAL_SECONDS=300
